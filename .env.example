# Local development only. Replace this with a password of your choice.
# Keep the password URL-safe for this simple example.
# Generate a strong token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DOCWEAVE_API_TOKEN=replace_with_a_long_random_token
DOCWEAVE_RATE_LIMIT_REQUESTS=120
DOCWEAVE_RATE_LIMIT_WINDOW_SECONDS=60

POSTGRES_PASSWORD=replace_with_a_local_password
DATABASE_URL=postgresql+psycopg://docweave:replace_with_a_local_password@127.0.0.1:5432/docweave
